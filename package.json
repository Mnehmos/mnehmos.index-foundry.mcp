{
  "name": "mnehmos.index-foundry.mcp",
  "version": "1.0.0",
  "description": "Deterministic Vector Index Factory - MCP Server",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mnehmos-index-foundry-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "Docs/**/*.md",
    "README.md",
    "PROJECT_KNOWLEDGE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "node scripts/copy-templates.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:template": "tsc --noEmit -p tsconfig.template.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "keywords": [
    "mcp",
    "vector-database",
    "rag",
    "embeddings",
    "indexing"
  ],
  "author": "Mnehmos",
  "license": "Proprietary",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.1",
    "franc-min": "^6.2.0",
    "glob": "^11.0.0",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "simhash-js": "^1.0.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "express": "^5.2.1",
    "globals": "^17.11.0",
    "pdf-lib": "^1.17.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
