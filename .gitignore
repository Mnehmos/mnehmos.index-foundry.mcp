# Dependencies
node_modules/

# Build output
dist/

# Environment
.env
.env.local

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Run artifacts (generated during pipeline execution)
/runs/

# Project data (generated embeddings and chunks)
/projects/*/data/
/projects/*/runs/
/projects/*/node_modules/
/projects/*/dist/

# Temporary files
*.tmp
*.temp

# Database files
*.db
*.sqlite
*.sqlite3

# Screenshots (test artifacts)
screenshots/

# Local project data (multi-GB) + per-user settings.
# Anchored with a leading slash: an unanchored `projects/` also matched
# src/tools/projects/, silently excluding source files from the repo.
/projects/
.claude/settings.local.json

# Generated per-project runtime state and machine-local config
.server.pid
/projects/*/frontend/local.config.js

# Repowise local index/cache
/.repowise/
